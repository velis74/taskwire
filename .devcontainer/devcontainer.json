{
  // The demo (`demo.py`): the FastAPI server on 8030 and the Vite client on 5174, which proxies the
  // server, so the browser needs only 5174.
  "name": "taskwire demo",
  "image": "mcr.microsoft.com/devcontainers/python:3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "hostRequirements": { "cpus": 2 },
  // TASKWIRE_DEMO_VITE_HOST: Vite listens on all interfaces; `localhost` resolves to `::1` only in the container.
  "containerEnv": { "UV_LINK_MODE": "copy", "TASKWIRE_DEMO_VITE_HOST": "1" },
  "postCreateCommand": "pipx install uv && uv sync --locked && npm ci",
  "postAttachCommand": "curl -sf -o /dev/null localhost:5174 && echo 'The demo is already running.' || uv run python demo.py",
  // No forwardPorts: the ports are forwarded when the demo starts listening, and onAutoForward opens the frontend.
  "portsAttributes": {
    "5174": { "label": "Demo", "onAutoForward": "openBrowserOnce" },
    "8030": { "label": "Demo server", "onAutoForward": "silent" }
  },
  // No venv activation in terminals: it types into the demo's terminal and interrupts the demo; uv run needs none.
  "customizations": {
    "codespaces": { "openFiles": [".devcontainer/README.md"] },
    "vscode": {
      "settings": {
        "python.terminal.activateEnvironment": false,
        "python-envs.terminal.autoActivationType": "off"
      },
      "extensions": ["ms-python.python", "Vue.volar"]
    }
  }
}
