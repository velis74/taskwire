{
  "config": {
    "MD013": { "line_length": 120, "tables": false, "code_blocks": false },
    // Keep a Changelog repeats Added / Changed / Fixed under every version
    "MD024": { "siblings_only": true },
    // the design documents carry their title in front matter as well as in the first heading
    "MD025": { "front_matter_title": "" },
    // a numbered list continues its numbering across the paragraphs that interrupt it
    "MD029": false,
    // the docs embed Vue components and <div v-pre>
    "MD033": false,
    // VitePress builds heading anchors differently from markdownlint's GitHub slugs (`0.2.0` -> `0-2-0`)
    "MD051": false
  },
  "ignores": [".venv/**", "**/node_modules/**", "**/dist/**", "coverage/**", "docs/.vitepress/cache/**"]
}
