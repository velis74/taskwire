{
  "name": "taskwire",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "Progress reporting and awaitable dialogs for long-running server-side operations.",
  "author": "Jure Erznožnik",
  "license": "MIT",
  "files": ["dist/*"],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".":         { "require": "./dist/index.cjs",    "import": "./dist/index.js" },
    "./vue":     { "require": "./dist/vue.cjs",      "import": "./dist/vue.js" },
    "./muxws":   { "require": "./dist/muxws.cjs",    "import": "./dist/muxws.js" },
    "./vuetify": { "require": "./dist/vuetify.cjs",  "import": "./dist/vuetify.js" }
  },
  "workspaces": ["docs", "examples/several-operations"],
  "scripts": {
    "build": "vite build",
    "test": "vitest run --coverage",
    "lint": "eslint ts --fix && vue-tsc --noEmit",
    "docs:dev": "npm run docs:dev -w docs",
    "docs:build": "npm run docs:build -w docs",
    "docs:preview": "npm run docs:preview -w docs"
  },
  "keywords": ["progress", "dialogs", "dynamicforms", "velis", "vue"],
  "repository": { "type": "git", "url": "git@github.com:velis74/taskwire.git" },
  "peerDependencies": {
    "@dynamicforms/vuetify-modal-form-kit": "^0.1.0",
    "muxws": "^0.2.0",
    "axios": "^1.13.6",
    "vue": "^3.4",
    "vuetify": "^3.9"
  },
  "peerDependenciesMeta": {
    "@dynamicforms/vuetify-modal-form-kit": { "optional": true },
    "muxws": { "optional": true },
    "vue": { "optional": true },
    "vuetify": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^24",
    "@vitejs/plugin-vue": "^6",
    "@vitest/coverage-v8": "^3",
    "@vue/test-utils": "^2.2.4",
    "@vue/tsconfig": "^0.7.0",
    "eslint-config-velis": "^2.0.12",
    "jsdom": "^26.0.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "typescript": "^5",
    "vite": "^8",
    "vite-plugin-dts": "^5",
    "vitest": "^3",
    "vue-tsc": "^2"
  }
}
