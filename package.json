{
  "name": "taskwire",
  "private": false,
  "version": "0.2.0",
  "type": "module",
  "description": "Progress reporting and awaitable dialogs for long-running server-side operations.",
  "author": "Jure Erznožnik",
  "license": "MIT",
  "files": [
    "dist/*"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./vue": {
      "require": "./dist/vue.cjs",
      "import": "./dist/vue.js"
    },
    "./muxws": {
      "require": "./dist/muxws.cjs",
      "import": "./dist/muxws.js"
    },
    "./vuetify": {
      "require": "./dist/vuetify.cjs",
      "import": "./dist/vuetify.js"
    },
    "./conformance": {
      "require": "./dist/conformance.cjs",
      "import": "./dist/conformance.js"
    }
  },
  "workspaces": [
    "docs",
    "demo/client"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run --coverage",
    "lint": "eslint ts --fix && vue-tsc --noEmit",
    "lint:ci": "eslint ts && vue-tsc --noEmit",
    "docs:dev": "npm run docs:dev -w docs",
    "docs:build": "npm run docs:build -w docs",
    "docs:preview": "npm run docs:preview -w docs"
  },
  "keywords": [
    "progress",
    "dialogs",
    "dynamicforms",
    "velis",
    "vue"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:velis74/taskwire.git"
  },
  "peerDependencies": {
    "@dynamicforms/fastapi-viewsets": "^0.5.0",
    "@dynamicforms/vuetify-modal-form-kit": "^0.7.0",
    "axios": "^1.13.6",
    "muxws": "^0.3.1",
    "vue": "^3.4",
    "vuetify": "^3.9"
  },
  "peerDependenciesMeta": {
    "@dynamicforms/fastapi-viewsets": {
      "optional": true
    },
    "@dynamicforms/vuetify-modal-form-kit": {
      "optional": true
    },
    "muxws": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vuetify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dynamicforms/fastapi-viewsets": "^0.5.1",
    "@dynamicforms/vuetify-modal-form-kit": "^0.7.3",
    "@types/node": "^24",
    "@vitejs/plugin-vue": "^6",
    "@vitest/coverage-v8": "^3",
    "@vue/test-utils": "^2.2.4",
    "@vue/tsconfig": "^0.7.0",
    "eslint-config-velis": "^2.0.12",
    "jsdom": "^26.0.0",
    "muxws": "^0.3.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "typescript": "^5",
    "vite": "^8",
    "vite-plugin-dts": "^5",
    "vitest": "^3",
    "vue-tsc": "^2",
    "vuetify": "^3.13.1"
  }
}
