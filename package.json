{
  "name": "taskwire",
  "private": false,
  "version": "0.4.4",
  "type": "module",
  "description": "Progress reporting and awaitable dialogs for long-running server-side operations.",
  "author": "Jure Erznožnik",
  "license": "MIT",
  "files": [
    "dist/*"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./muxws": {
      "import": {
        "types": "./dist/muxws.d.ts",
        "default": "./dist/muxws.js"
      },
      "require": {
        "types": "./dist/muxws.d.cts",
        "default": "./dist/muxws.cjs"
      }
    },
    "./vuetify": {
      "import": {
        "types": "./dist/vuetify.d.ts",
        "default": "./dist/vuetify.js"
      },
      "require": {
        "types": "./dist/vuetify.d.cts",
        "default": "./dist/vuetify.cjs"
      }
    },
    "./fastapi-viewsets": {
      "import": {
        "types": "./dist/fastapi-viewsets.d.ts",
        "default": "./dist/fastapi-viewsets.js"
      },
      "require": {
        "types": "./dist/fastapi-viewsets.d.cts",
        "default": "./dist/fastapi-viewsets.cjs"
      }
    },
    "./conformance": {
      "import": {
        "types": "./dist/conformance.d.ts",
        "default": "./dist/conformance.js"
      },
      "require": {
        "types": "./dist/conformance.d.cts",
        "default": "./dist/conformance.cjs"
      }
    }
  },
  "workspaces": [
    "docs",
    "demo/client"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run --coverage",
    "lint": "node scripts/lint.mjs",
    "docs:dev": "npm run docs:dev -w docs",
    "docs:build": "npm run docs:build -w docs",
    "docs:preview": "npm run docs:preview -w docs"
  },
  "keywords": [
    "progress",
    "dialogs",
    "dynamicforms",
    "velis",
    "vue"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:velis74/taskwire.git"
  },
  "peerDependencies": {
    "@dynamicforms/fastapi-viewsets": ">=0.13.0 <0.15",
    "@dynamicforms/vuetify-inputs": "^0.15.0",
    "@dynamicforms/vuetify-modal-form-kit": "^0.11.0",
    "axios": "^1.13.6",
    "muxws": "^0.4.1",
    "vue": "^3.4",
    "vuetify": "^3.9"
  },
  "peerDependenciesMeta": {
    "@dynamicforms/fastapi-viewsets": {
      "optional": true
    },
    "@dynamicforms/vuetify-inputs": {
      "optional": true
    },
    "@dynamicforms/vuetify-modal-form-kit": {
      "optional": true
    },
    "muxws": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vuetify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dynamicforms/fastapi-viewsets": "^0.14.2",
    "@dynamicforms/vuetify-inputs": "^0.15.0",
    "@dynamicforms/vuetify-modal-form-kit": "^0.11.0",
    "@types/node": "^26",
    "@vitejs/plugin-vue": "^6",
    "@vitest/coverage-v8": "^3",
    "@vue/test-utils": "^2.2.4",
    "@vue/tsconfig": "^0.7.0",
    "eslint-config-velis": "^3.0.1",
    "jsdom": "^26.0.0",
    "markdownlint-cli2": "^0.18.1",
    "muxws": "^0.4.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "typescript": "^5",
    "vite": "^8",
    "vite-plugin-dts": "^5",
    "vitest": "^3",
    "vue-tsc": "^2",
    "vuetify": "^3.13.1"
  }
}
