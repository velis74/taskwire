{
  "extends": "./node_modules/eslint-config-velis/tsconfig.json",
  "compilerOptions": {
    // The base config sets `module: commonjs`; the sources are ESM (vite emits ES and CJS) and
    // `import.meta` is a syntax error under commonjs.
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": { "@/*": ["./vue/*"], "~/*": ["./node_modules/*"] },
    "types": ["vitest/globals", "node"],
    "skipLibCheck": true
  },
  "include": ["vue/**/*"],
  "exclude": [".venv", "dist", "coverage", "node_modules", "docs", "taskwire"]
}
